{
  "base_config": {
    "model": "SYMUNET_POSTTRAIN_BEFORE",
    "dataset": "UCMerced",
    "scale": 4,
    "epochs": 500,
    "batch_size": 8,
    "ext": "img",
    "patch_size": 192,
    "resume": 0
  },
  "hyperparameter_grid": {
    "optimizer": ["ADAMW"],
    "scheduler": ["step"],
    "lr": [4e-4],
    "loss": [
      "1*L1"
    ],
    "symunet_posttrain_width": [48],
    "symunet_posttrain_enc_blk_nums": [
      "4,6" 
    ],
    "symunet_posttrain_dec_blk_nums": [
      "6,4"
    ]
  },
  "experiment_prefix": "symunet_post_before_2lr",
  "max_experiments": 20,
  "use_wandb": true,
  "wandb_project": "SymUNet-Batch-Experiments",
  "save_every_n_steps": 50,
  "run_name_pattern": "{prefix}_blk46_{loss}_sch{scheduler}_w{symunet_posttrain_width}"
}