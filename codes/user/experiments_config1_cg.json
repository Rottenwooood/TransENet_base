{
  "base_config": {
    "model": "CSYMMUNET_PRETRAIN_CG",
    "dataset": "UCMerced",
    "scale": 4,
    "epochs": 300,
    "batch_size": 4,
    "ext": "img",
    "patch_size": 192,
    "resume": 0
  },
  "hyperparameter_grid": {
    "optimizer": ["ADAMW"],
    "scheduler": ["step"],
    "lr": [2e-4],
    "loss": [
      "1*L1"
    ],
    "symunet_pretrain_width": [32],
    "symunet_pretrain_enc_blk_nums": [
      "4,6"
    ],
    "symunet_pretrain_dec_blk_nums": [
      "6,4"
    ],
    "symunet_pretrain_gce_conv": [2]
  },
  "experiment_prefix": "cg_pretrain",
  "max_experiments": 20,
  "use_wandb": true,
  "wandb_project": "SymUNet-Pretrain-Variants",
  "save_every_n_steps": 50,
  "run_name_pattern": "{prefix}_gce{symunet_pretrain_gce_conv}_w{symunet_pretrain_width}_e{epochs}"
}
